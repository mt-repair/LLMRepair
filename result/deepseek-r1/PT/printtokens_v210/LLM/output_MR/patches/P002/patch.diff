+static void skip_comment(token_stream tstream_ptr, token token_ptr, int cu_state, char token_str[], int token_ind, char ch) {
+    // Skip until end of line or EOF
+    while((ch=get_char(tstream_ptr->ch_stream)) != '\n' && !is_end_of_character_stream(tstream_ptr->ch_stream)) {
+        if(token_ind >= 80) break;
+        token_str[token_ind++] = ch;
+    }
+    return(error_or_eof_case(tstream_ptr,token_ptr,cu_state,token_str,token_ind,ch));
